---
import Arrow from './Arrow.astro';
import type { CollectionEntry } from 'astro:content';
import { dateLabel, readingMinutes } from '../lib/content';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="entries">
  {posts.map(post => <article class="entry">
    <a class="entry-link" href={`/blog/${post.id}/`}>
      <div class="entry-meta eyebrow">
        <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} min read</span>
      </div>
      <h2>{post.data.title}<span class="entry-arrow"><Arrow /></span></h2>
      {post.data.description && <p>{post.data.description}</p>}
      {post.data.tags.length > 0 && <ul class="entry-tags" aria-label="Topics">{post.data.tags.map(tag => <li>{tag}</li>)}</ul>}
    </a>
  </article>)}
</div>
