---
import type { CollectionEntry } from 'astro:content';
import { dateLabel } from '../lib/content';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="entries">
  {posts.map(post => <article class="entry">
    <time class="eyebrow" datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
    <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
    {post.data.description && <p>{post.data.description}</p>}
  </article>)}
</div>
