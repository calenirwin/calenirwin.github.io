---
import Base from '../../layouts/Base.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import ProjectDetails from '../../components/ProjectDetails.astro';
import { publishedProjects } from '../../lib/content';
export async function getStaticPaths() { return (await publishedProjects()).map(project => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
---
<Base title={project.data.title} description={project.data.description}>
  <article class="reading page-section project-page">
    <a class="quiet-link" href="/projects/">← Projects</a>
    <header class="article-header"><h1>{project.data.title}</h1></header>
    <ProjectPreview project={project} />
    <ProjectDetails project={project} />
  </article>
</Base>
