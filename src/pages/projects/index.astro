---
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board.astro';
import { publishedProjects } from '../../lib/content';
import { getEntry, render } from 'astro:content';
const projects = await publishedProjects();
const page = (await getEntry('pages', 'projects'))!;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}><section class="wrap page-section index-page">
  <header class="index-header"><h1>{page.data.title}</h1><div class="prose page-deck"><Content /></div></header>
  <div class="project-list">{projects.map((project, index) => <article class="project-entry">
    <a class="project-card" href={`/projects/${project.id}/`}>
      <div class="project-visual" aria-hidden="true">{project.id === 'hnefatafl' ? <Board /> : <span>{String(index + 1).padStart(2, '0')}</span>}</div>
      <div class="project-copy">
        <div class="project-meta eyebrow"><span>{String(index + 1).padStart(2, '0')}</span>{project.data.status && <span>{project.data.status}</span>}</div>
        <h2>{project.data.title}<span class="entry-arrow" aria-hidden="true">↗</span></h2>
        {project.data.description && <p>{project.data.description}</p>}
      </div>
    </a>
  </article>)}</div>
  {!projects.length && <p class="empty">No published projects yet.</p>}
</section></Base>
