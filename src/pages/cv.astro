---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const page = (await getEntry('pages', 'cv'))!;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <section class="reading page-section cv-page">
    <div class="cv-heading"><h1>{page.data.title}</h1>{page.data.download && <a class="quiet-link" href={page.data.download} download>Download PDF ↓</a>}</div>
    <div class="prose"><Content /></div>
  </section>
</Base>
