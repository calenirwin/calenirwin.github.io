---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description} preloadImages={page.data.portrait ? [
  { href: '/images/albion-portrait-frame.webp', type: 'image/webp' },
  { href: page.data.portrait, type: page.data.portrait.endsWith('.png') ? 'image/png' : page.data.portrait.endsWith('.webp') ? 'image/webp' : 'image/jpeg' },
] : []}>
  <section class:list={['wrap', 'page-section', 'about-page', { 'with-portrait': page.data.portrait }]}>
    <div class="about-copy">
      <h1>{page.data.title}</h1>
      <div class="prose"><Content /></div>
    </div>
    {page.data.portrait && <figure class="portrait">
      <img class="portrait-frame" src="/images/albion-portrait-frame.webp" alt="" width="672" height="840" loading="eager" fetchpriority="high" aria-hidden="true" />
      <img class="portrait-photo" src={page.data.portrait} alt={page.data.portraitAlt} width="600" height="750" loading="eager" fetchpriority="high" />
    </figure>}
  </section>
</Base>
