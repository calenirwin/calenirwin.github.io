---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/surfaces.css';
import site from '../../content/settings.json';
import { getEntry } from 'astro:content';
interface Props { title?: string; description?: string; article?: { date: Date; tags: string[] }; preloadImages?: { href: string; type: string }[]; }
const { title, description = site.description, article, preloadImages = [] } = Astro.props;
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site);
const socialImage = new URL('/images/calen-irwin-social.png', Astro.site);
const links = [['Blog', '/blog/'], ['Projects', '/projects/'], ['About', '/about/'], ['CV', '/cv/']];
const blogPage = (await getEntry('pages', 'blog'))!;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.name}` : site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={blogPage.data.title} href={new URL('/rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preloadImages.map(image => <link rel="preload" href={image.href} as="image" type={image.type} fetchpriority="high" />)}
    <meta name="theme-color" content="#092D42" />
    <meta property="og:title" content={title || site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.date.toISOString()} />}
    {article && <meta property="article:author" content={site.name} />}
    {article?.tags.map(tag => <meta property="article:tag" content={tag} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <ClientRouter fallback="animate" />
  </head>
  <body class:list={{ 'home-page': current === '/', 'blog-index': current === '/blog/' }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', 'wrap', { 'home-header': current === '/' }]}>
      {current !== '/' && <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>}
      <nav aria-label="Main navigation">{links.map(([label, href]) => <a href={href} aria-current={current === href ? 'page' : current.startsWith(href) ? 'location' : undefined}>{label}</a>)}</nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <a class="feed-link" href="/rss.xml">Subscribe via RSS</a>
      <div class="footer-links">
        {site.github && <a href={site.github} aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>}
        {site.linkedin && <a href={site.linkedin} aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zM3.743 5.182c.837 0 1.358-.554 1.358-1.248-.015-.709-.521-1.248-1.342-1.248-.821 0-1.358.54-1.358 1.248 0 .694.521 1.248 1.327 1.248h.015zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.763-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169H6.25c.03.678 0 7.225 0 7.225h2.401z"/></svg>
        </a>}
      </div>
    </footer>
  </body>
</html>
